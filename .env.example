# Google Pollen API — per-type Tree/Grass/Weed indices for all cities.
# Create at https://console.cloud.google.com/apis/credentials after enabling
# the "Pollen API" for your project. Without this the app shows an explicit
# error for every city except Raleigh rather than inventing numbers.
GOOGLE_POLLEN_API_KEY=

# Email alerts (already configured in Vercel)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RESEND_API_KEY=
CRON_SECRET=
